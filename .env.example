# API Keys
# TMDB API key (required for movie/TV lookups)
TMDB_API_KEY=
# Google Books API key (optional, enhances book metadata)
GOOGLE_BOOKS_API_KEY=
# Hardcover API key (optional, for tropes/tags/ratings — get from hardcover.app/account/api)
HARDCOVER_API_KEY=

# Transport
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PATH=/mcp
# Optional extra trusted hostnames (comma-separated; no schemes, ports, or wildcards).
# Localhost remains allowed. These guards mitigate DNS rebinding and cross-origin
# browser calls, not remote access: non-browser clients can set Host and omit Origin.
# They are not authentication; MCP_AUTH_TOKEN below is.
# MCP_ALLOWED_HOSTS=media.internal
# MCP_ALLOWED_ORIGINS=ui.internal
# Bearer token for HTTP clients (Authorization: Bearer <token>); at least 32
# characters. Required whenever MCP_HTTP_HOST is not loopback, including in
# Docker. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Set to 1 only when another layer (an authenticating proxy) restricts access;
# it lets the server listen beyond loopback without MCP_AUTH_TOKEN.
# MCP_ALLOW_UNAUTHENTICATED=1

# Cache
MCP_CACHE_ENABLED=true
MCP_CACHE_PATH=./cache.db
MCP_CACHE_TTL_BOOKS=604800
MCP_CACHE_TTL_MOVIES=86400
MCP_CACHE_TTL_TV=86400
MCP_CACHE_CLEANUP_INTERVAL_MS=3600000

# Rate Limiting
MCP_RATE_LIMIT_RPM=30
MCP_RATE_LIMIT_RETRIES=3

# Features
MCP_ENABLE_GOODREADS_SCRAPING=true

# Logging
MCP_LOG_LEVEL=info

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=media-metadata-mcp
